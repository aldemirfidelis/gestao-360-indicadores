<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_Implantacao" targetNamespace="https://gestao360.org/processes">
 <bpmn:collaboration id="Collaboration_Implantacao"><bpmn:participant id="Pool_Implantacao" name="Implantação de solução digital" processRef="Process_Implantacao" /></bpmn:collaboration>
 <bpmn:process id="Process_Implantacao" name="Implantação de solução digital" isExecutable="false">
 <bpmn:laneSet id="LaneSet_1"><bpmn:lane id="Lane_0" name="Comercial e análise"><bpmn:flowNodeRef>Start</bpmn:flowNodeRef><bpmn:flowNodeRef>Requirements</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="Lane_1" name="Engenharia e qualidade"><bpmn:flowNodeRef>Development</bpmn:flowNodeRef><bpmn:flowNodeRef>Tests</bpmn:flowNodeRef><bpmn:flowNodeRef>Decision</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="Lane_2" name="Implantação e cliente"><bpmn:flowNodeRef>Deployment</bpmn:flowNodeRef><bpmn:flowNodeRef>End</bpmn:flowNodeRef></bpmn:lane></bpmn:laneSet>
 <bpmn:startEvent id="Start" name="Início"><bpmn:outgoing>F1</bpmn:outgoing></bpmn:startEvent>
<bpmn:userTask id="Requirements" name="Analisar requisitos"><bpmn:incoming>F1</bpmn:incoming><bpmn:outgoing>F2</bpmn:outgoing></bpmn:userTask>
<bpmn:task id="Development" name="Desenvolver solução"><bpmn:incoming>F2</bpmn:incoming><bpmn:incoming>F7</bpmn:incoming><bpmn:outgoing>F3</bpmn:outgoing></bpmn:task>
<bpmn:userTask id="Tests" name="Executar testes"><bpmn:incoming>F3</bpmn:incoming><bpmn:outgoing>F4</bpmn:outgoing></bpmn:userTask>
<bpmn:exclusiveGateway id="Decision" name="Testes aprovados?"><bpmn:incoming>F4</bpmn:incoming><bpmn:outgoing>F5</bpmn:outgoing><bpmn:outgoing>F7</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:serviceTask id="Deployment" name="Implantar solução"><bpmn:incoming>F5</bpmn:incoming><bpmn:outgoing>F6</bpmn:outgoing></bpmn:serviceTask>
<bpmn:endEvent id="End" name="Solução implantada"><bpmn:incoming>F6</bpmn:incoming></bpmn:endEvent>
 <bpmn:sequenceFlow id="F1" sourceRef="Start" targetRef="Requirements" />
<bpmn:sequenceFlow id="F2" sourceRef="Requirements" targetRef="Development" />
<bpmn:sequenceFlow id="F3" sourceRef="Development" targetRef="Tests" />
<bpmn:sequenceFlow id="F4" sourceRef="Tests" targetRef="Decision" />
<bpmn:sequenceFlow id="F5" sourceRef="Decision" targetRef="Deployment" name="Sim" />
<bpmn:sequenceFlow id="F6" sourceRef="Deployment" targetRef="End" />
<bpmn:sequenceFlow id="F7" sourceRef="Decision" targetRef="Development" name="Revisar" />
 </bpmn:process>
 <bpmndi:BPMNDiagram id="Diagram_1"><bpmndi:BPMNPlane id="Plane_1" bpmnElement="Collaboration_Implantacao">
 <bpmndi:BPMNShape id="Pool_di" bpmnElement="Pool_Implantacao" isHorizontal="true"><dc:Bounds x="0" y="0" width="1200" height="600" /></bpmndi:BPMNShape>
 <bpmndi:BPMNShape id="Lane_0_di" bpmnElement="Lane_0" isHorizontal="true"><dc:Bounds x="30" y="0" width="1170" height="200" /></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="Lane_1_di" bpmnElement="Lane_1" isHorizontal="true"><dc:Bounds x="30" y="200" width="1170" height="200" /></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="Lane_2_di" bpmnElement="Lane_2" isHorizontal="true"><dc:Bounds x="30" y="400" width="1170" height="200" /></bpmndi:BPMNShape>
 <bpmndi:BPMNShape id="Start_di" bpmnElement="Start"><dc:Bounds x="80" y="85" width="36" height="36" /></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="Requirements_di" bpmnElement="Requirements"><dc:Bounds x="180" y="65" width="120" height="80" /></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="Development_di" bpmnElement="Development"><dc:Bounds x="360" y="245" width="120" height="80" /></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="Tests_di" bpmnElement="Tests"><dc:Bounds x="550" y="245" width="120" height="80" /></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="Decision_di" bpmnElement="Decision"><dc:Bounds x="730" y="260" width="50" height="50" /></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="Deployment_di" bpmnElement="Deployment"><dc:Bounds x="860" y="445" width="120" height="80" /></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="End_di" bpmnElement="End"><dc:Bounds x="1080" y="465" width="36" height="36" /></bpmndi:BPMNShape>
 <bpmndi:BPMNEdge id="F1_di" bpmnElement="F1"><di:waypoint x="116" y="103" /><di:waypoint x="180" y="105" /></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="F2_di" bpmnElement="F2"><di:waypoint x="300" y="105" /><di:waypoint x="360" y="285" /></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="F3_di" bpmnElement="F3"><di:waypoint x="480" y="285" /><di:waypoint x="550" y="285" /></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="F4_di" bpmnElement="F4"><di:waypoint x="670" y="285" /><di:waypoint x="730" y="285" /></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="F5_di" bpmnElement="F5"><di:waypoint x="780" y="285" /><di:waypoint x="820" y="285" /><di:waypoint x="820" y="485" /><di:waypoint x="860" y="485" /></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="F6_di" bpmnElement="F6"><di:waypoint x="980" y="485" /><di:waypoint x="1080" y="483" /></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="F7_di" bpmnElement="F7"><di:waypoint x="755" y="310" /><di:waypoint x="755" y="380" /><di:waypoint x="420" y="380" /><di:waypoint x="420" y="325" /></bpmndi:BPMNEdge>
 </bpmndi:BPMNPlane></bpmndi:BPMNDiagram>
</bpmn:definitions>